# Copy this file to .env and adjust the values.

# Backend target for the Vite dev/preview proxy. This is server-side only; the
# browser always calls /api on the Vite origin.
VITE_API_PROXY_TARGET=http://localhost:3000

# Base URL the production build calls directly (no Vite proxy is available on a
# static host). Leave unset to use the deployed API; set it when the API moves.
# VITE_API_BASE_URL=https://kiosk-api-znxy.onrender.com

# Server-side rendering (`npm run dev` / `npm start`).
# Where the Node server loads the catalog from (runtime, not baked into the
# bundle). Defaults to VITE_API_BASE_URL, then http://localhost:3000.
# API_URL=https://kiosk-api-znxy.onrender.com

# Public origin used for canonical/Open Graph/sitemap URLs. Defaults to the
# request's Host header.
# PUBLIC_ORIGIN=https://kiosk-ssr.onrender.com

# Public URL for catalog images (og:image must be reachable by crawlers). Use
# this when API_URL points at a private network address.
# PUBLIC_API_URL=https://kiosk-api-znxy.onrender.com
